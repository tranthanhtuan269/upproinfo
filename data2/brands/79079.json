  "description": "<p style=\"margin-top: 0pt; margin-bottom: 0pt;\"><strong><span style=\"font-size: 11pt; font-family: Arial; text-decoration: underline; text-decoration-skip-ink: none;\">Company Description&nbsp;</span></strong></p>\r\n<p style=\"margin-top: 0pt; margin-bottom: 0pt;\"><span style=\"font-size: 11pt; font-family: Arial;\">Welcome to Hyperspace! We design and create infinity lighting for homes and entertainment spaces. These are lights that look like they have an infinite amount of light and space within.&nbsp;</span></p>\r\n<p style=\"margin-top: 0pt; margin-bottom: 0pt;\">&nbsp;</p>\r\n<p style=\"margin-top: 0pt; margin-bottom: 0pt;\"><strong><span style=\"font-size: 11pt; font-family: Arial; text-decoration: underline; text-decoration-skip-ink: none;\">Features: All of our products come with the following features:</span></strong></p>\r\n<ul style=\"margin-top: 0px; margin-bottom: 0px; padding-inline-start: 48px;\">\r\n<li style=\"font-size: 11pt; font-family: Arial;\">\r\n<p style=\"margin-top: 0pt; margin-bottom: 0pt;\"><span style=\"font-size: 11pt;\">3 modes and 95 custom coded patterns</span></p>\r\n</li>\r\n<li style=\"font-size: 11pt; font-family: Arial;\">\r\n<p style=\"margin-top: 0pt; margin-bottom: 0pt;\"><span style=\"font-size: 11pt;\">Hyperspace app enabled - customize the vibe</span></p>\r\n</li>\r\n<li style=\"font-size: 11pt; font-family: Arial;\">\r\n<p style=\"margin-top: 0pt; margin-bottom: 0pt;\"><span style=\"font-size: 11pt;\">Advanced sound reactivity - visualize the music&nbsp;</span></p>\r\n</li>\r\n<li style=\"font-size: 11pt; font-family: Arial;\">\r\n<p style=\"margin-top: 0pt; margin-bottom: 0pt;\"><span style=\"font-size: 11pt;\">Syncable - to coordinate multiple HyperLights</span></p>\r\n</li>\r\n<li style=\"font-size: 11pt; font-family: Arial;\">\r\n<p style=\"margin-top: 0pt; margin-bottom: 0pt;\"><span style=\"font-size: 11pt;\">Scratch proof - so you can pick them up and touch them&nbsp;</span></p>\r\n</li>\r\n<li style=\"font-size: 11pt; font-family: Arial;\">\r\n<p style=\"margin-top: 0pt; margin-bottom: 0pt;\"><span style=\"font-size: 11pt;\">1 year warranty - if its our fault, we cover it&nbsp;</span></p>\r\n</li>\r\n</ul>\r\n<p style=\"margin-top: 0pt; margin-bottom: 0pt;\"><strong><span style=\"font-size: 11pt; font-family: Arial; text-decoration: underline; text-decoration-skip-ink: none;\">Payment Terms</span></strong></p>\r\n<p style=\"margin-top: 0pt; margin-bottom: 0pt;\"><span style=\"font-size: 11pt; font-family: Arial;\">10% commission&nbsp;</span></p>\r\n<p style=\"margin-top: 0pt; margin-bottom: 0pt;\"><span style=\"font-size: 11pt; font-family: Arial;\">Payments are made via PayPal 30 days after verified sales have been completed. </span></p>",
