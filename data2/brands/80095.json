  "description": "<main id=\"MainContent\" tabindex=\"-1\" role=\"main\">\r\n<section id=\"shopify-section-template--16736178077983__main\">\r\n<div>\r\n<div>\r\n<h2><span style=\"font-size: 12pt;\">We are a group of bike enthusiasts that love to take the party with us on the ride. Our team's HQ being Australia but, our partners are scattered across the globe. There is no where out of our reach.</span></h2>\r\n<h2><span style=\"font-size: 12pt;\">Our true belief is that technology can be used to enhance the riding experience whether it be a strong front light to ensure you can see in front of you in the dark, power banks to keep your device on, phone holders and of course speakers. We bring all of the different elements in order to take the riding experience to the next level and make your bike as unique as you are.</span></h2>\r\n<div>&nbsp;</div>\r\n</div>\r\n</div>\r\n</section>\r\n<section id=\"shopify-section-template--16736178077983__newsletter\">\r\n<div>\r\n<div>&nbsp;</div>\r\n</div>\r\n</section>\r\n</main>\r\n<p>&nbsp;</p>",
