li data-end=\"956\" data-start=\"882\" style=\"font-size: 12pt;\">\r\n<pre><span style=\"font-size: 12pt;\">Commission rates will be clearly outlined in your affiliate dashboard.</span></pre>\r\n</li>\r\n<li data-end=\"1002\" data-start=\"957\" style=\"font-size: 12pt;\">\r\n<pre><span style=\"font-size: 12pt;\">Payouts are processed monthly via PayPal.</span></pre>\r\n</li>\r\n<li data-end=\"1079\" data-start=\"1003\" style=\"font-size: 12pt;\">\r\n<pre><span style=\"font-size: 12pt;\">Any fraudulent sales or chargebacks will not be eligible for commission.</span></pre>\r\n</li>\r\n</ul>\r\n<pre data-end=\"1111\" data-start=\"1081\"><span style=\"font-size: 12pt;\">5. Promotional Materials</span></pre>\r\n<ul data-end=\"1260\" data-start=\"1112\">\r\n<li data-end=\"1194\" data-start=\"1112\" style=\"font-size: 12pt;\">\r\n<pre><span style=\"font-size: 12pt;\">Affiliates may only use approved marketing materials provided by Huku Balance.</span></pre>\r\n</li>\r\n<li data-end=\"1260\" data-start=\"1195\" style=\"font-size: 12pt;\">\r\n<pre><span style=\"font-size: 12pt;\">Use of our logo and branding must comply with our guidelines.</span></pre>\r\n</li>\r\n</ul>\r\n<pre data-end=\"1282\" data-start=\"1262\"><span style=\"font-size: 12pt;\">6. Termination</span></pre>\r\n<ul data-end=\"1404\" data-start=\"1283\">\r\n<li data-end=\"1404\" data-start=\"1283\" style=\"font-size: 12pt;\">\r\n<pre><span style=\"font-size: 12pt;\">We reserve the right to terminate an affiliate account at any time for misconduct or non-compliance with these terms.</span></pre>\r\n</li>\r\n</ul>",
