  "description": "<table style=\"width: 100%; height: 353.547px;\" border=\"1\"><colgroup><col style=\"width: 50.0419%;\"><col style=\"width: 49.9581%;\"></colgroup>\r\n<tbody>\r\n<tr style=\"height: 20.7969px;\">\r\n<td style=\"height: 20.7969px;\">Brand introduction</td>\r\n<td style=\"height: 20.7969px;\"><a href=\"https://tingmengte.com/pages/about-us\">https://tingmengte.com/pages/about-us</a></td>\r\n</tr>\r\n<tr style=\"height: 41.5938px;\">\r\n<td style=\"height: 41.5938px;\">Product description</td>\r\n<td style=\"height: 41.5938px;\">The flagship products of Tingmengte are the latest 6'' and 8'' chainsaws. These chainsaws are known for their excellent quality and affordability.</td>\r\n</tr>\r\n<tr style=\"height: 62.3906px;\">\r\n<td style=\"height: 145.578px;\" rowspan=\"2\">USP (Unique Selling Point)</td>\r\n<td style=\"height: 62.3906px;\">【<strong>Built-in Chain Adjustment】-</strong>&nbsp;No need for additional tools or complicated procedures. Our chainsaw features a built-in chain adjustment mechanism, allowing you to effortlessly tweak the chain tension by simply twisting the knob.&nbsp;</td>\r\n</tr>\r\n<tr style=\"height: 83.1875px;\">\r\n<td style=\"height: 83.1875px;\"><span style=\"color: rgb(0, 0, 0);\" data-sanitized-data-mce-style=\"color: #ffff00;\"><strong>【Effortless Lubrication】- </strong></span>Enjoy hassle-free chain lubrication with our innovative design. Simply pour lubricating oil directly into the chainsaw's oil reservoir and conveniently squeeze the bubble on top to effortlessly apply oil to the chain.</td>\r\n</tr>\r\n<tr style=\"height: 41.5938px;\">\r\n<td style=\"height: 83.1876px;\" rowspan=\"3\">Payment terms</td>\r\n<td style=\"height: 41.5938px;\">Commission Payments: Affiliates will receive commission payments based on the agreed-upon commission rate for each successful referral or sale they generate.</td>\r\n</tr>\r\n<tr style=\"height: 41.5938px;\">\r\n<td style=\"height: 41.5938px;\">Payment Schedule: Commission payments will be made on a monthly basis, typically within 30 days after the end of each month.</td>\r\n</tr>\r\n<tr style=\"height: 62.3906px;\">\r\n<td style=\"height: 62.3906px;\">Payment Method: Commission payments will be made via PayPal or direct bank transfer, whichever is preferred by the affiliate. Please provide your preferred payment details for smooth processing.</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p style=\"text-align: left; font-size: 14px; font-weight: normal;\">&nbsp;</p>",
