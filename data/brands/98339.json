 auto; padding-bottom: 10px;\" data-extraclass=\"\" data-row-gap=\"20px\" data-id=\"1526703573940\" data-icon=\"gpicon-row\" data-label=\"Row\">\r\n<div id=\"c-1526703104023\" class=\"gf_col-md-12 gf_column gf_col-xs-12\" style=\"box-sizing: border-box; min-height: auto; padding-left: 20px; padding-right: 20px; position: relative; float: left; width: 570px; z-index: 1; margin: 0px;\" data-id=\"1526703104023\">\r\n<div id=\"e-1526703573951\" class=\"element-wrap\" style=\"box-sizing: border-box; position: relative; z-index: 1;\" data-id=\"1526703573951\" data-icon=\"gpicon-heading\" data-label=\"Heading\">\r\n<div class=\"elm text-edit gf-elm-center gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs\" style=\"box-sizing: border-box; text-align: left; width: 530px; display: block;\" data-exc=\"\">\r\n<h2 style=\"box-sizing: border-box; text-transform: uppercase; font-family: Montserrat, sans-serif; color: rgb(34, 34, 34); line-height: 1.6em; font-size: 18px; text-align: inherit; margin: 0px; padding: 0px;\">OUR COMMITMENT</h2>\r\n</div>\r\n</div>\r\n<div id=\"e-1526703573884\" class=\"element-wrap\" style=\"box-sizing: border-box; position: relative; z-index: 1; margin-top: 15px;\" data-id=\"1526703573884\" data-icon=\"gpicon-textblock\" data-label=\"Text Block\">\r\n<div class=\"elm text-edit gf-elm-left gf-elm-justify-lg gf-elm-justify-md gf-elm-justify-sm gf-elm-justify-xs\" style=\"box-sizing: border-box; text-align: justify; width: 530px; display: block; line-height: 1.6em; font-size: 15px;\" data-exc=\"\">\r\n<p style=\"box-sizing: border-box; margin: 0px; font-size: inherit; font-family: inherit; line-height: inherit; text-align: inherit; padding: 0px;\">Keep the oceans clean. We strive to be a 100% natural company. All products are made of glass with very minimal packaging. All atmosphere mist and yoga mat spray packaging can be reused or recycled. We have a strong affinity to the sea and are dedicated to keeping it clean. A portion of proceeds from products sold are donated to Surfers Against Sewage. We regularly partake in beach cleans to keep the coastlines of Britain clean and safe.</p>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n<div id=\"c-1526701441019\" class=\"gf_column gf_col-md-6 gf_col-sm-12 gf_col-xs-12\" style=\"box-sizing: border-box; min-height: auto; padding-left: 15px; padding-right: 15px; position: relative; width: 600px; z-index: 1; margin: 0px; float: right;\" data-id=\"1526701441019\">\r\n<div id=\"r-1526703573969\" class=\"gf_row gf_row-gap-20\" style=\"box-sizing: border-box; position: relative; z-index: 1; max-width: 1200px; padding-top: 30px; margin-left: auto; margin-right: auto; padding-bottom: 10px;\" data-extraclass=\"\" data-row-gap=\"20px\" data-id=\"1526703573969\" data-icon=\"gpicon-row\" data-label=\"Row\">\r\n<div id=\"c-1526703104023\" class=\"gf_col-md-12 gf_column\" style=\"box-sizing: border-box; min-height: auto; padding-left: 20px; padding-right: 20px; position: relative; float: left; width: 570px; z-index: 1; margin: 0px;\" data-id=\"1526703104023\">\r\n<div id=\"e-1526703156570\" class=\"element-wrap\" style=\"box-sizing: border-box; position: relative; z-index: 1;\" data-id=\"1526703156570\" data-icon=\"gpicon-image\" data-label=\"Image\">\r\n<div class=\"elm gf-elm-center gf_elm-left-xs gf-elm-center-md gf-elm-center-sm gf-elm-center-xs gf-elm-center-lg\" style=\"box-sizing: border-box; text-align: center; width: 530px; display: block;\" data-exc=\"\"><img class=\"gf_image\" style=\"box-sizing: border-box; max-width: 100%; transition: all 0s ease-in-out 0s; vertical-align: bottom; width: 265px; display: inline-block; margin-left: 0px; margin-right: 0px; height: auto;\" src=\"https://ucarecdn.com/465a6836-6355-4a77-8b43-c25f8d8cbf82/-/format/auto/-/preview/3000x3000/-/quality/lighter/\" alt=\"\"></div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n<div id=\"r-1533064907177\" class=\"gf_row\" style=\"box-sizing: border-box; z-index: 1; max-width: 1200px